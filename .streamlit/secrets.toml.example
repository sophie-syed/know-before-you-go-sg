# Copy this file to .streamlit/secrets.toml for local use.
# Never commit your real key.
OPENAI_API_KEY = "your-key-here"
OPENAI_MODEL = "gpt-6.1-terra"

# Recommended for the submitted prototype.
APP_PASSWORD = "choose-a-test-password"

# Optional: enables SLA OneMap walking-route estimates.
ONEMAP_API_TOKEN = "your-onemap-token"

